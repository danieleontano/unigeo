---
import Base from "@/layouts/Base.astro";
import { Tempo, type UnitaICS } from "@/components/Tempo";
import carta from "../../content/tempo/carta-ics.json";

// La carta cronostratigrafica internazionale ufficiale (ICS), dai dati che la
// Commissione pubblica: scripts/carta-ics.ts la scarica, una GitHub Action
// controlla ogni settimana se ne è uscita una versione nuova.
---

<Base titolo="Scala del tempo" tema="sottosuolo" largo>
  <p class="etichetta">Paleontologia · il tempo profondo</p>
  <h1 class="mt-1 text-[2rem] leading-tight">Scala del tempo geologico</h1>
  <div class="mt-5">
    <Tempo client:load unita={carta.unita as UnitaICS[]} versione={carta.versione} modificata={carta.modificata} />
  </div>
  <p class="mt-8 max-w-prose font-sans text-[0.7rem] leading-snug text-grafite">
    Fonte: {carta.fonte}, versione {carta.versione}, controllata il {carta.scaricato.split("-").reverse().join("/")}; si aggiorna da sola quando la Commissione pubblica una
    nuova versione. Nomi italiani della carta ufficiale. Per l'esame fa fede la carta in
    <a href="https://stratigraphy.org/chart" target="_blank" rel="noopener noreferrer" class="underline">stratigraphy.org/chart</a>.
  </p>
</Base>

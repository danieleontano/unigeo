---
import Base from "@/layouts/Base.astro";
import scala from "../../content/tempo/scala.json";

// La scala del tempo geologico in quattro colonne (eone, era, periodo, epoca)
// come la carta ICS, dall'alto (oggi) verso il basso (4567 Ma). La scala
// verticale è la radice quadrata dell'età: lineare schiaccerebbe tutto il
// Fanerozoico in un ottavo della pagina.
type Unita = { nome: string; inglese: string; livello: string; da: number; a: number; colore: string };
const unita = scala.unita as Unita[];
const ALTEZZA = 3200;
const MAX = 4567;
const y = (eta: number) => (Math.sqrt(eta) / Math.sqrt(MAX)) * ALTEZZA;
const LIVELLI = [
  { id: "eone", nome: "Eone" },
  { id: "era", nome: "Era" },
  { id: "periodo", nome: "Periodo" },
  { id: "epoca", nome: "Epoca" },
];
const TACCHE = [1, 10, 66, 145, 252, 541, 1000, 2000, 3000, 4000];
function eta(ma: number): string {
  if (ma === 0) return "oggi";
  if (ma < 0.1) return `${Math.round(ma * 1000)} ka`;
  if (ma >= 1000) return `${(ma / 1000).toLocaleString("it-IT", { maximumFractionDigits: 3 })} Ga`;
  return `${ma.toLocaleString("it-IT", { maximumFractionDigits: 3 })} Ma`;
}
---

<Base titolo="Scala del tempo" tema="sottosuolo" largo>
  <p class="etichetta">Il tempo profondo</p>
  <h1 class="mt-1 text-[2rem] leading-tight">Scala del tempo geologico</h1>
  <p class="mt-1 max-w-prose text-sm text-grafite">Tocca un'unità per le età. Più scendi, più indietro vai: in fondo la formazione della Terra, 4,567 Ga.</p>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_300px]">
    <div class="relative overflow-hidden rounded-sm border border-filetto" style={`height:${ALTEZZA + 40}px`}>
      <div class="relative z-10 grid grid-cols-[44px_repeat(4,1fr)] border-b border-filetto font-sans text-[0.6rem] uppercase tracking-wider text-grafite" style="background: color-mix(in srgb, var(--carta) 92%, transparent)">
        <span class="px-1 py-1.5">Ma</span>
        {LIVELLI.map((l) => <span class="px-1.5 py-1.5">{l.nome}</span>)}
      </div>
      <div class="relative grid grid-cols-[44px_repeat(4,1fr)]" style={`height:${ALTEZZA}px`}>
        <div class="relative border-r border-filetto">
          {TACCHE.map((t) => (
            <span class="absolute right-1 -translate-y-1/2 font-sans text-[0.58rem] tabular-nums text-grafite" style={`top:${y(t)}px`}>{t >= 1000 ? `${t / 1000} Ga` : t}</span>
          ))}
        </div>
        {LIVELLI.map((l) => (
          <div class="relative border-r border-filetto/50">
            {unita.filter((u) => u.livello === l.id).map((u) => {
              const alto = y(u.a);
              const h = Math.max(1, y(u.da) - alto);
              return (
                <button
                  type="button"
                  class="unita absolute left-0 right-0 overflow-hidden border-b border-black/25 px-1.5 text-left font-sans text-[0.68rem] leading-tight text-black/80 transition hover:brightness-110 focus:z-10 focus:outline focus:outline-2 focus:outline-lava"
                  style={`top:${alto}px;height:${h}px;background:${u.colore}`}
                  data-nome={u.nome}
                  data-inglese={u.inglese}
                  data-livello={l.nome}
                  data-da={eta(u.da)}
                  data-a={eta(u.a)}
                  data-durata={eta(u.da - u.a)}
                  title={`${u.nome}: ${eta(u.da)} – ${eta(u.a)}`}
                >
                  {h > 13 && <span class="block truncate pt-0.5 font-medium">{u.nome}</span>}
                </button>
              );
            })}
          </div>
        ))}
        <div class="pointer-events-none absolute left-11 right-0 top-0 h-0.5 bg-lava" aria-hidden="true" />
      </div>
    </div>

    <aside class="lg:sticky lg:top-20 lg:self-start">
      <div id="scheda" class="foglio p-4 pt-6">
        <p class="etichetta" data-campo="livello">Tu sei qui</p>
        <p class="display mt-1 text-2xl leading-tight" data-campo="nome">Olocene</p>
        <p class="mt-0.5 font-sans text-xs text-grafite" data-campo="inglese">Holocene</p>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 font-sans text-sm">
          <dt class="text-grafite">Inizio</dt><dd data-campo="da">11,7 ka</dd>
          <dt class="text-grafite">Fine</dt><dd data-campo="a">oggi</dd>
          <dt class="text-grafite">Durata</dt><dd data-campo="durata">11,7 ka</dd>
        </dl>
      </div>
      <p class="mt-3 font-sans text-[0.65rem] leading-snug text-grafite">
        Fonte: {scala.fonte}, scaricata il {scala.scaricato.split("-").reverse().join("/")}. Per l'esame fa fede la carta ICS:
        <a href="https://stratigraphy.org/chart" target="_blank" rel="noopener noreferrer" class="underline">stratigraphy.org/chart</a>.
      </p>
    </aside>
  </div>
</Base>

<script>
  function avvia() {
    const scheda = document.getElementById("scheda");
    if (!scheda) return;
    document.querySelectorAll<HTMLButtonElement>("button.unita").forEach((b) => {
      b.addEventListener("click", () => {
        for (const campo of ["nome", "inglese", "livello", "da", "a", "durata"]) {
          const el = scheda.querySelector<HTMLElement>(`[data-campo="${campo}"]`);
          if (el) el.textContent = b.dataset[campo] ?? "";
        }
        scheda.classList.remove("entra-girando");
        void scheda.offsetWidth;
        scheda.classList.add("entra-girando");
        if (window.innerWidth < 1024) scheda.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    });
  }
  document.addEventListener("astro:page-load", avvia);
</script>

---
import Base from "@/layouts/Base.astro";
import { Ripasso } from "@/components/Ripasso";
import { schedeLezioni } from "@/lib/contenuti";

const lezioni = await schedeLezioni();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base tema="sottosuolo" titolo="Ripasso">
  <h1 class="text-2xl font-semibold">Ripasso</h1>
  <p class="mt-1 text-sm text-grafite">Materia per materia. Il riquadro è la litificazione: da sedimento sciolto a roccia compatta.</p>
  <Ripasso client:load lezioni={lezioni} base={base} />
</Base>

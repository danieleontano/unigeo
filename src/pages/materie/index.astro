---
import Base from "@/layouts/Base.astro";
import Campione from "@/components/Campione.astro";
import Inclina from "@/components/Inclina.astro";
import Colonna from "@/components/Colonna.astro";
import { percorso } from "@/lib/percorsi";
import { contaDefinizioni, lezioniDi, quizDisponibili, tutteLeMaterie } from "@/lib/contenuti";

const materie = await tutteLeMaterie();
const lezioni = await lezioniDi();
const quiz = await quizDisponibili();
const righe = materie.map((m) => {
  const mie = lezioni.filter((l) => l.id.startsWith(`${m.id}/`));
  return { m, mie, nQuiz: mie.filter((l) => quiz.has(l.id)).length, nDef: mie.reduce((s, l) => s + contaDefinizioni(l), 0) };
});
---

<Base titolo="Materie" tema="sottosuolo" largo>
  <p class="etichetta">La teca dei campioni</p>
  <h1 class="mt-1 text-[2rem] leading-tight">Materie</h1>
  <p class="mt-1 font-sans text-xs text-grafite">Muovi il puntatore o inclina il telefono.</p>

  <ul class="deposita mt-8 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {righe.map(({ m, mie, nQuiz, nDef }) => (
      <li style={`--materia:${m.data.colore}`}>
        <a href={percorso(`/materie/${m.id}`)} class="group block">
          <div class="flex justify-center py-2">
            <Campione colore={m.data.colore} materia={m.id} misura={200} />
          </div>
          <div class="mt-4 flex items-end gap-4">
            <div class="w-10 shrink-0">
              <Colonna lezioni={mie} colore={m.data.colore} modo="mini" altezza={Math.max(10, mie.length * 10)} />
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="text-xl leading-tight">{m.data.nome}</h2>
              <p class="truncate text-sm text-grafite">{m.data.docenti.length ? m.data.docenti.join(", ") : "Docente da definire"}</p>
              <p class="mt-1 font-sans text-xs text-grafite">
                <span class="display text-base font-semibold text-materia">{mie.length}</span> lezioni
                {nQuiz > 0 && <> · <span class="display text-base font-semibold text-materia">{nQuiz}</span> quiz</>}
                {nDef > 0 && <> · <span class="display text-base font-semibold text-materia">{nDef}</span> campioni</>}
              </p>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <p class="mt-14 font-sans text-sm text-grafite">
    <a href={percorso("/pagine/libri-di-testo")} class="text-inchiostro underline decoration-filetto underline-offset-4 hover:decoration-inchiostro">Libri di testo del primo anno</a>
  </p>
  <Inclina />
</Base>

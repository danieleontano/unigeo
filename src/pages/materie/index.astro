---
import Base from "@/layouts/Base.astro";
import Testata from "@/components/Testata.astro";
import SchedeMaterie from "@/components/SchedeMaterie.astro";
import { percorso } from "@/lib/percorsi";
import { lezioniDi, tutteLeMaterie } from "@/lib/contenuti";

const materie = await tutteLeMaterie();
const lezioni = await lezioniDi();
---

<Base titolo="Materie">
  <Testata occhiello="Primo anno · primo semestre" titolo="Le materie" descrizione={`${lezioni.length} lezioni in ${materie.length} materie. Ogni sasso porta ai suoi appunti.`} simbolo="strati">
    <a href={percorso("/pagine/libri-di-testo")} class="bottone bottone-chiaro">Libri di testo</a>
  </Testata>
  <SchedeMaterie misura={170} />
</Base>

---
import { getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { percorso } from "@/lib/percorsi";
import { dataLunga } from "@/lib/date";
import { contaDefinizioni, lezioniDi, materiaDiLezione, percorsoLezione, percorsoQuiz, quizDisponibili, slugDiLezione } from "@/lib/contenuti";
import { AzioniLezione } from "@/components/AzioniLezione";
import SpunteVive from "@/components/SpunteVive.astro";

export async function getStaticPaths() {
  const lezioni = await lezioniDi();
  return lezioni.map((l, i) => ({
    params: { materia: materiaDiLezione(l), slug: slugDiLezione(l) },
    props: {
      lezione: l,
      precedente: lezioni.slice(0, i).reverse().find((x) => materiaDiLezione(x) === materiaDiLezione(l)) ?? null,
      successiva: lezioni.slice(i + 1).find((x) => materiaDiLezione(x) === materiaDiLezione(l)) ?? null,
    },
  }));
}

const { lezione, precedente, successiva } = Astro.props;
const materia = await getEntry("materie", lezione.data.materia);
if (!materia) throw new Error(`Materia sconosciuta: ${lezione.data.materia}`);
const { Content, headings } = await render(lezione);
const sezioni = headings.filter((h) => h.depth === 2);
const d = lezione.data;
const haQuiz = (await quizDisponibili()).has(lezione.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base tema="carta" larghezza="testo" titolo={`${d.titolo} · ${materia.data.nome}`} colore={materia.data.colore}>
  <header class="mb-6 border-b border-slate pb-4">
    <a href={percorso(`/materie/${materia.id}`)} class="sans text-xs font-semibold uppercase tracking-[0.2em] text-materia">
      {materia.data.nome}{d.modulo && ` · ${d.modulo}`}
    </a>
    <h1 class="mt-1 text-2xl font-semibold leading-tight">Lezione {d.numero} · {d.titolo}</h1>
    <p class="mt-1.5 text-sm text-muted">
      <b class="font-semibold text-ink">{dataLunga(d.data)}</b>
      {d.docente && <> · {d.docente}</>}
      {d.fonte && <> · {d.fonte}</>}
    </p>
    {d.nota && <p class="mt-2 text-sm text-muted">{d.nota}</p>}
    {(d.pdf || d.dispense.length > 0) && (
      <p class="sans mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs print:hidden">
        {d.pdf && <a href={percorso(d.pdf)} class="text-materia hover:underline">PDF della lezione</a>}
        {d.dispense.map((x) => <a href={percorso(x.file)} class="text-materia hover:underline">Dispensa · {x.titolo}</a>)}
      </p>
    )}
  </header>

  {sezioni.length > 1 && (
    <nav class="mb-6 print:hidden">
      <ol class="indice">
        {sezioni.map((s) => (
          <li><a href={`#${s.slug}`}>{s.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <article class="appunti" data-lezione={lezione.id}>
    <Content />
  </article>
  <SpunteVive />

  <AzioniLezione
    client:load
    idLezione={lezione.id}
    haQuiz={haQuiz}
    percorsoQuiz={percorsoQuiz(lezione)}
    percorsoFlashcard={contaDefinizioni(lezione) > 0 ? `/flashcard/${materia.id}` : null}
    base={base}
  />

  <nav class="sans mt-10 flex justify-between gap-4 border-t border-line pt-4 text-sm print:hidden">
    {precedente ? (
      <a href={percorso(percorsoLezione(precedente))} class="min-w-0 text-muted hover:text-slate">
        <span class="block text-xs">← Lezione {precedente.data.numero}</span>
        <span class="block truncate">{precedente.data.titolo}</span>
      </a>
    ) : <span />}
    {successiva ? (
      <a href={percorso(percorsoLezione(successiva))} class="min-w-0 text-right text-muted hover:text-slate">
        <span class="block text-xs">Lezione {successiva.data.numero} →</span>
        <span class="block truncate">{successiva.data.titolo}</span>
      </a>
    ) : <span />}
  </nav>
</Base>

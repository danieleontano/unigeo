---
import Base from "@/layouts/Base.astro";
import Testata from "@/components/Testata.astro";
import OggettoMateria from "@/components/OggettoMateria.astro";
import SchedeStrumenti from "@/components/SchedeStrumenti.astro";
import { percorso } from "@/lib/percorsi";
import { strumentiDi } from "@/lib/strumenti";
import { dataBreve } from "@/lib/date";
import { getCollection } from "astro:content";
import { contaDefinizioni, lezioniDi, percorsoQuiz, tutteLeMaterie } from "@/lib/contenuti";

export async function getStaticPaths() {
  const materie = await tutteLeMaterie();
  return materie.map((m) => ({ params: { materia: m.id }, props: { materia: m } }));
}

const { materia } = Astro.props;
const lezioni = await lezioniDi(materia.id);
const domandePerLezione = new Map((await getCollection("quiz")).map((q) => [q.id, q.data.domande.length]));
const d = materia.data;
const definizioni = lezioni.reduce((s, l) => s + contaDefinizioni(l), 0);
const conQuiz = lezioni.filter((l) => domandePerLezione.has(l.id));
const nDomande = conQuiz.reduce((n, l) => n + (domandePerLezione.get(l.id) ?? 0), 0);
const strumenti = strumentiDi(materia.id);
---

<Base titolo={d.nome} colore={d.colore}>
  <Testata occhiello={d.moduli ? d.moduli.join(" · ") : "Materia"} titolo={d.nome} descrizione={[d.docenti.join(", ") || "Docente da definire", d.esame].filter(Boolean).join(" · ")} colore={d.colore}>
    <div slot="arte"><OggettoMateria id={materia.id} colore={d.colore} /></div>
    {lezioni.length > 0 && <a href={percorso(`/materie/${materia.id}/libro`)} class="bottone bottone-materia">Apri il Libro · {lezioni.length} {lezioni.length === 1 ? "capitolo" : "capitoli"}</a>}
  </Testata>

  {lezioni.length === 0 ? (
    <p class="pannello p-5 text-grafite">Nessuna lezione ancora.</p>
  ) : (
    <section class="pannello p-4 sm:p-5">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <h2 class="pannello-titolo mr-auto">Quiz</h2>
        {conQuiz.length > 0 && <a href={percorso(`/quiz/${materia.id}`)} class="bottone bottone-vuoto !py-1 text-xs">Quiz misto · {nDomande}</a>}
        {definizioni > 0 && <a href={percorso(`/flashcard/${materia.id}`)} class="bottone bottone-vuoto !py-1 text-xs">Flashcard · {definizioni}</a>}
        {conQuiz.length > 0 && <a href={percorso(`/ripasso#${materia.id}`)} class="bottone bottone-vuoto !py-1 text-xs">Ripasso</a>}
      </div>
      {conQuiz.length === 0 ? (
        <p class="text-sm text-grafite">Nessun quiz ancora.</p>
      ) : (
        <>
          <div class="mb-2 flex items-center gap-2" id="comandi" hidden={conQuiz.length <= 8}>
            <input id="filtro" type="search" placeholder="Cerca" class="w-40 rounded-lg border border-filetto bg-transparent px-3 py-1 font-sans text-sm outline-none focus:border-grafite sm:w-56" autocomplete="off" />
          </div>
          <ol id="lezioni" class="divide-y divide-filetto border-t border-filetto">
            {conQuiz.map((l) => (
              <li data-testo={`${l.data.numero} ${l.data.titolo} ${l.data.docente ?? ""} ${l.data.tag.join(" ")}`.toLowerCase()}>
                <a href={percorso(percorsoQuiz(l))} class="riga">
                  <span class="display w-7 shrink-0 text-right text-sm font-semibold text-materia">{String(l.data.numero).padStart(2, "0")}</span>
                  <span class="min-w-0 flex-1 truncate">{l.data.titolo}</span>
                  <span class="font-sans shrink-0 text-xs tabular-nums text-grafite">{domandePerLezione.get(l.id)} dom.</span>
                  <span class="font-sans hidden w-20 shrink-0 text-right text-xs tabular-nums text-grafite sm:block">{dataBreve(l.data.data)}</span>
                </a>
              </li>
            ))}
          </ol>
          <p id="vuoto" class="mt-4 text-sm text-grafite" hidden>Nessun quiz corrisponde.</p>
        </>
      )}
    </section>
  )}

  {strumenti.length > 0 && (
    <>
      <div class="sezione-titolo"><h2>Strumenti</h2></div>
      <SchedeStrumenti strumenti={strumenti} />
    </>
  )}
</Base>

<script>
  function avvia() {
  const filtro = document.getElementById("filtro") as HTMLInputElement | null;
  const lista = document.getElementById("lezioni");
  const vuoto = document.getElementById("vuoto");

  filtro?.addEventListener("input", () => {
    const parole = filtro.value.toLowerCase().split(/\s+/).filter(Boolean);
    let visibili = 0;
    lista?.querySelectorAll<HTMLLIElement>("li").forEach((li) => {
      const ok = parole.every((p) => (li.dataset.testo ?? "").includes(p));
      li.hidden = !ok;
      if (ok) visibili++;
    });
    if (vuoto) vuoto.hidden = visibili > 0;
  });

  }
  document.addEventListener("astro:page-load", avvia);
</script>

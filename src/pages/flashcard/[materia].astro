---
import Base from "@/layouts/Base.astro";
import Testata from "@/components/Testata.astro";
import { Flashcard } from "@/components/Flashcard";
import { lezioniDi, tutteLeMaterie } from "@/lib/contenuti";
import { carteDiLezione } from "@/lib/flashcard";

export async function getStaticPaths() {
  const materie = await tutteLeMaterie();
  return materie.map((m) => ({ params: { materia: m.id }, props: { materia: m } }));
}

const { materia } = Astro.props;
const lezioni = await lezioniDi(materia.id);
const carte = lezioni.flatMap(carteDiLezione);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titolo={`Flashcard · ${materia.data.nome}`} colore={materia.data.colore} larghezza="testo">
  <Testata occhiello={materia.data.nome} titolo="Flashcard" descrizione={`${carte.length} definizioni dagli appunti.`} simbolo="ripasso" colore={materia.data.colore} />
  <div>
    {carte.length === 0 ? (
      <p class="text-sm text-muted">Nessuna definizione ancora in questa materia.</p>
    ) : (
      <Flashcard client:load nomeMateria={materia.data.nome} colore={materia.data.colore} carte={carte} base={base} />
    )}
  </div>
</Base>

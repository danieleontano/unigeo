---
import Base from "@/layouts/Base.astro";
import Sezione from "@/components/Sezione.astro";
import { Oggi } from "@/components/Oggi";
import { Caldera } from "@/components/Caldera";
import { percorso } from "@/lib/percorsi";
import { dataLunga } from "@/lib/date";
import { lezioniDi, schedeLezioni, tutteLeMaterie } from "@/lib/contenuti";
import { oggiIso } from "@/lib/ripasso";

const schede = await schedeLezioni();
const materie = await tutteLeMaterie();
const lezioni = await lezioniDi();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const oggi = oggiIso();
---

<Base titolo="Home" descrizione="Appunti e ripasso del primo anno di Scienze Geologiche." tema="sottosuolo" nudo>
  {/* La superficie: il taccuino appoggiato sul buio, il vulcano accanto. */}
  <section class="relative mx-auto max-w-5xl px-4 pb-16 pt-8 sm:pt-12">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[1fr_320px]">
      <div class="foglio deposita p-5 pt-6 sm:p-7 sm:pt-8">
        <p class="etichetta">Taccuino da campo</p>
        <h1 class="mt-1 text-[1.9rem] leading-tight sm:text-[2.3rem]">{dataLunga(oggi)}</h1>

        <section class="mt-6">
          <div class="flex items-baseline justify-between">
            <h2 class="text-lg">Da ripassare</h2>
            <a href={percorso("/ripasso")} class="font-sans text-xs text-grafite hover:text-inchiostro">calendario →</a>
          </div>
          <Oggi client:load lezioni={schede} base={base} />
        </section>

      </div>

      <aside class="deposita lg:pt-6">
        <p class="etichetta mb-2 text-center">La caldera</p>
        <Caldera client:load />
        <p class="mt-6 text-center font-sans text-xs text-grafite">
          Gli ultimi strati depositati. <span class="text-inchiostro">Scorri per scendere.</span>
        </p>
        <div class="mx-auto mt-2 h-8 w-px bg-gradient-to-b from-grafite to-transparent" aria-hidden="true" />
      </aside>
    </div>
  </section>

  <Sezione lezioni={lezioni} materie={materie} limite={6} />

  <section class="mx-auto max-w-5xl px-4 py-10 text-center">
    <a href={percorso("/materie")} class="bottone bottone-lava">Vai ai campioni delle materie</a>
  </section>
</Base>

---
import Base from "@/layouts/Base.astro";
import { percorso } from "@/lib/percorsi";
import { dataBreve } from "@/lib/date";
import { materiaDiLezione, percorsoLezione, tutteLeMaterie, ultimeLezioni } from "@/lib/contenuti";

const materie = await tutteLeMaterie();
const nomeMateria = new Map(materie.map((m) => [m.id, m.data]));
const ultime = await ultimeLezioni(5);
---

<Base titolo="Oggi" descrizione="Appunti e ripasso del primo anno di Scienze Geologiche.">
  <h1 class="text-2xl font-semibold">Oggi</h1>

  <section class="mt-5">
    <h2 class="sans text-xs font-semibold uppercase tracking-[0.18em] text-muted">Da ripassare</h2>
    <p class="mt-2 text-sm text-muted">Nessun quiz ancora: arrivano col prossimo passo.</p>
  </section>

  <section class="mt-8">
    <h2 class="sans text-xs font-semibold uppercase tracking-[0.18em] text-muted">Ultime lezioni</h2>
    <ol class="mt-2 divide-y divide-line border-y border-line">
      {ultime.map((l) => {
        const m = nomeMateria.get(materiaDiLezione(l));
        return (
          <li style={`--materia:${m?.colore}`}>
            <a href={percorso(percorsoLezione(l))} class="flex items-center gap-3 py-1.5 hover:bg-sand/60">
              <span class="sans w-24 shrink-0 truncate text-xs font-semibold text-materia">{m?.nome}</span>
              <span class="min-w-0 flex-1 truncate">{l.data.numero} · {l.data.titolo}</span>
              <span class="sans w-20 shrink-0 text-right text-xs tabular-nums text-muted">{dataBreve(l.data.data)}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
</Base>

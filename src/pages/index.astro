---
// La Home, rifatta dopo l'audit del 04/10/2026: un'apertura, tre scorciatoie
// (ripasso, ultima lezione, terremoti) e le materie. Strumenti, ripasso
// completo e mappa hanno le loro pagine: qui non si ripetono.
import Base from "@/layouts/Base.astro";
import SchedeMaterie from "@/components/SchedeMaterie.astro";
import { RipassoBreve } from "@/components/RipassoBreve";
import { Orologio } from "@/components/Orologio";
import { percorso } from "@/lib/percorsi";
import { lezioniDi, percorsoLezione, schedeLezioni, tutteLeMaterie } from "@/lib/contenuti";
import { leggiSismi } from "@/lib/sismi";
import { dataBreve } from "@/lib/date";
import { giorniTra, oggiIso } from "@/lib/ripasso";

const schede = await schedeLezioni();
const materie = await tutteLeMaterie();
const lezioni = await lezioniDi();
const sismi = await leggiSismi();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Il semestre è iniziato martedì 22 settembre 2026 (prima lezione).
const settimana = Math.max(1, Math.floor(giorniTra("2026-09-21", oggiIso()) / 7) + 1);
const conLezioni = materie.filter((m) => lezioni.some((l) => l.id.startsWith(`${m.id}/`))).length;
const ultima = [...lezioni].sort((a, b) => String(b.data.data).localeCompare(String(a.data.data)) || b.data.numero - a.data.numero)[0];
const materiaUltima = ultima && materie.find((m) => ultima.id.startsWith(`${m.id}/`));
const sisma = sismi?.eventi[0];
const quando = (iso: string) => new Intl.DateTimeFormat("it-IT", { timeZone: "Europe/Rome", day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }).format(new Date(iso));
const freccia = '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-grafite transition group-hover:translate-x-0.5" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>';
---

<Base titolo="Home" descrizione="Appunti e ripasso del primo anno di Scienze Geologiche.">
  <section class="pannello testata">
    <svg class="filigrana" aria-hidden="true"><use href="#strati" /></svg>
    <Orologio client:load className="font-sans text-[0.7rem] font-semibold tracking-[0.14em] text-[#e3b08c]" />
    <h1 class="mt-1.5 text-[2.1rem] leading-tight sm:text-[2.5rem]">Ciao, Daniele</h1>
    <p class="mt-1 text-[0.95rem] text-grafite">Settimana {settimana} del primo semestre · {lezioni.length} lezioni in {conLezioni} materie</p>
  </section>

  <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
    <RipassoBreve client:load lezioni={schede} base={base} />

    {ultima && (
      <a href={percorso(percorsoLezione(ultima))} class="pannello scheda scheda-riga group !items-center" style={materiaUltima ? `--tinta:${materiaUltima.data.colore}` : undefined}>
        <span class="chip shrink-0">{materiaUltima ? <img src={percorso(`/icone/${materiaUltima.data.icona}`)} alt="" width="22" height="22" class="h-[22px] w-[22px]" /> : null}</span>
        <span class="min-w-0 flex-1">
          <span class="block text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-grafite">Ultima lezione</span>
          <span class="mt-0.5 block truncate text-[0.95rem] font-medium">{ultima.data.titolo}</span>
          <span class="block truncate text-xs text-grafite">{materiaUltima?.data.nome} · {dataBreve(ultima.data.data)}</span>
        </span>
        <Fragment set:html={freccia} />
      </a>
    )}

    <a href={percorso("/terremoti")} class="pannello scheda scheda-riga group !items-center">
      <span class="chip shrink-0"><svg class="h-5 w-5" aria-hidden="true"><use href="#sismogramma" /></svg></span>
      <span class="min-w-0 flex-1">
        <span class="block text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-grafite">La Terra adesso</span>
        <span class="mt-0.5 block truncate text-[0.95rem] font-medium">{sisma ? `M ${sisma.magnitudo.toLocaleString("it-IT")} · ${sisma.regione}` : "Terremoti nel Nord-Ovest"}</span>
        <span class="block truncate text-xs text-grafite">{sisma ? `${quando(sisma.quando)} · rete RSNI` : "Mappa RSNI"}</span>
      </span>
      <Fragment set:html={freccia} />
    </a>
  </div>

  <div class="sezione-titolo"><h2>Materie</h2><a href={percorso("/materie")}>tutte →</a></div>
  <SchedeMaterie />
</Base>

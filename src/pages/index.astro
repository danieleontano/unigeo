---
import Base from "@/layouts/Base.astro";
import Sezione from "@/components/Sezione.astro";
import Sismografo from "@/components/Sismografo.astro";
import SchedeStrumenti from "@/components/SchedeStrumenti.astro";
import SchedeMaterie from "@/components/SchedeMaterie.astro";
import { Oggi } from "@/components/Oggi";
import { Caldera } from "@/components/Caldera";
import { Orologio } from "@/components/Orologio";
import { percorso } from "@/lib/percorsi";
import { lezioniDi, schedeLezioni, tutteLeMaterie } from "@/lib/contenuti";
import { STRUMENTI } from "@/lib/strumenti";
import { giorniTra, oggiIso } from "@/lib/ripasso";

const schede = await schedeLezioni();
const materie = await tutteLeMaterie();
const lezioni = await lezioniDi();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Il semestre è iniziato martedì 22 settembre 2026 (prima lezione).
const settimana = Math.max(1, Math.floor(giorniTra("2026-09-21", oggiIso()) / 7) + 1);
const conLezioni = materie.filter((m) => lezioni.some((l) => l.id.startsWith(`${m.id}/`))).length;
---

<Base titolo="Home" descrizione="Appunti e ripasso del primo anno di Scienze Geologiche.">
  <section class="pannello testata" style="--materia:#c9552a">
    <svg class="filigrana" aria-hidden="true"><use href="#strati" /></svg>
    <Orologio client:load className="font-sans text-[0.7rem] font-semibold tracking-[0.14em] text-[#e07a4a]" />
    <h1 class="mt-1.5 text-[2.1rem] leading-tight sm:text-[2.5rem]">Ciao, Daniele</h1>
    <p class="mt-1 text-[0.95rem] text-grafite">Settimana {settimana} del primo semestre · {lezioni.length} lezioni in {conLezioni} materie</p>
  </section>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
    <section class="pannello p-5 lg:col-span-2">
      <div class="pannello-testa">
        <h2 class="pannello-titolo">Da ripassare oggi</h2>
        <a href={percorso("/ripasso")}>calendario →</a>
      </div>
      <Oggi client:load lezioni={schede} base={base} />
    </section>
    <section class="pannello p-5">
      <h2 class="pannello-titolo">La tua settimana</h2>
      <div class="mx-auto mt-2 max-w-[150px] lg:max-w-[180px]"><Caldera client:load /></div>
    </section>
  </div>

  <div class="sezione-titolo"><h2>Materie</h2><a href={percorso("/materie")}>tutte →</a></div>
  <SchedeMaterie />

  <div class="sezione-titolo"><h2>Strumenti</h2><a href={percorso("/strumenti")}>tutti →</a></div>
  <SchedeStrumenti strumenti={STRUMENTI.slice(0, 6)} />

  <div class="sezione-titolo"><h2>La Terra adesso</h2><a href={percorso("/terremoti")}>mappa →</a></div>
  <Sismografo />

  <div class="sezione-titolo"><h2>Ultimi strati depositati</h2><a href={percorso("/materie")}>tutte le lezioni →</a></div>
  <div class="overflow-hidden rounded-[0.85rem] border border-[#3d322a]">
    <Sezione lezioni={lezioni} materie={materie} limite={4} />
  </div>
</Base>

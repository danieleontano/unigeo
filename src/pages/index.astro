---
import Base from "@/layouts/Base.astro";
import { Oggi } from "@/components/Oggi";
import { percorso } from "@/lib/percorsi";
import { dataBreve } from "@/lib/date";
import { schedeLezioni } from "@/lib/contenuti";

const lezioni = await schedeLezioni();
const ultime = [...lezioni].sort((a, b) => b.data.localeCompare(a.data) || b.numero - a.numero).slice(0, 5);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titolo="Oggi" descrizione="Appunti e ripasso del primo anno di Scienze Geologiche.">
  <h1 class="text-2xl font-semibold">Oggi</h1>

  <section class="mt-5">
    <h2 class="sans text-xs font-semibold uppercase tracking-[0.18em] text-muted">Da ripassare</h2>
    <Oggi client:load lezioni={lezioni} base={base} />
  </section>

  <section class="mt-8">
    <h2 class="sans text-xs font-semibold uppercase tracking-[0.18em] text-muted">Ultime lezioni</h2>
    <ol class="mt-2 divide-y divide-line border-y border-line">
      {ultime.map((l) => (
        <li style={`--materia:${l.colore}`}>
          <a href={percorso(l.percorsoLezione)} class="flex items-center gap-3 py-1.5 hover:bg-sand/60">
            <span class="sans w-24 shrink-0 truncate text-xs font-semibold text-materia">{l.nomeMateria}</span>
            <span class="min-w-0 flex-1 truncate">{l.numero} · {l.titolo}</span>
            <span class="sans w-20 shrink-0 text-right text-xs tabular-nums text-muted">{dataBreve(l.data)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

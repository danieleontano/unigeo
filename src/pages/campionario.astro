---
import Base from "@/layouts/Base.astro";
import Testata from "@/components/Testata.astro";
import { Riconosci, type CampioneFoto } from "@/components/Riconosci";
import campioni from "../../content/campionario/campioni.json";

const conFoto = (campioni as unknown as CampioneFoto[]).filter((c) => c.foto);
const rocce = conFoto.filter((c) => c.tipo !== "minerale").length;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titolo="Riconosci la pietra" colore="#B5552A">
  <Testata occhiello="Geologia 1 · campionario" titolo="Riconosci la pietra" descrizione={`${rocce} rocce e ${conFoto.length - rocce} minerali in foto. Foto libere da Wikimedia Commons.`} simbolo="martello" colore="#B5552A" />
  <Riconosci client:load campioni={conFoto} base={base} />
</Base>

---
import Base from "@/layouts/Base.astro";
import { Riconosci, type CampioneFoto } from "@/components/Riconosci";
import campioni from "../../content/campionario/campioni.json";

const conFoto = (campioni as unknown as CampioneFoto[]).filter((c) => c.foto);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titolo="Riconosci la pietra" tema="sottosuolo">
  <p class="etichetta">Il campionario</p>
  <h1 class="mt-1 text-[2rem] leading-tight">Riconosci la pietra</h1>
  <div class="mt-5">
    <Riconosci client:load campioni={conFoto} base={base} />
  </div>
  <p class="mt-8 font-sans text-[0.7rem] text-grafite">
    Foto libere da Wikimedia Commons: sassi di tutto il mondo, non il set del laboratorio. Le foto dei campioni dell'esame si aggiungono in
    <code>content/campionario/campioni.json</code>.
  </p>
</Base>

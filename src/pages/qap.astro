---
import Base from "@/layouts/Base.astro";
import Testata from "@/components/Testata.astro";
import { Qap } from "@/components/Qap";
---

<Base titolo="Diagramma QAPF" colore="#B5552A">
  <Testata occhiello="Geologia 1 · lezione 5" titolo="Diagramma QAPF" descrizione="Rocce magmatiche con femici sotto il 90%: quarzo o feldspatoidi, feldspati alcalini e plagioclasi riportati a 100." simbolo="triangolo" colore="#B5552A" />
  <Qap client:load />
  <p class="mt-6 max-w-prose font-sans text-[0.7rem] text-grafite">Campi e nomi secondo la classificazione IUGS (Streckeisen 1976; Le Maitre et al. 2002). Per l'esame fanno fede i diagrammi dati dal docente.</p>
</Base>

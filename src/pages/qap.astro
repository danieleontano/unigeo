---
import Base from "@/layouts/Base.astro";
import Testata from "@/components/Testata.astro";
import { Magmatiche, type GruppoGlossario } from "@/components/Magmatiche";
import glossario from "../../content/geologia-1/glossario-magmatiche.json";
---

<Base titolo="Rocce magmatiche" larghezza="pieno" colore="#B5552A">
  <Testata piana titolo="Classificare le rocce magmatiche" descrizione="Il metodo della lezione 5 e i diagrammi delle slide: ultrafemiche, Streckeisen per intrusive ed effusive, vetrose." />
  <Magmatiche client:load glossario={glossario.gruppi as GruppoGlossario[]} />
  <p class="mt-6 max-w-prose font-sans text-[0.7rem] text-grafite">Dalle slide «3. Le rocce magmatiche» di Geologia 1 (M. Piazza): diagrammi da Le Maitre et al. 2002 e atlas-hornin.sk, piroclastiti da IODP. Per l'esame fanno fede le slide del docente.</p>
</Base>

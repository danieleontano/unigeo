---
import Base from "@/layouts/Base.astro";
import { DaFare } from "@/components/DaFare";
import { lezioniDi, tutteLeMaterie } from "@/lib/contenuti";
import { coseDaFareDi } from "@/lib/dafare";

const lezioni = await lezioniDi();
const voci = lezioni.flatMap(coseDaFareDi);
const materie = (await tutteLeMaterie()).map((m) => ({ id: m.id, nome: m.data.nome, colore: m.data.colore }));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titolo="Da fare">
  <p class="etichetta">Dettate dai prof, più le tue</p>
  <h1 class="mt-1 text-[2rem] leading-tight">Da fare</h1>
  <div class="mt-6">
    <DaFare client:load voci={voci} materie={materie} base={base} />
  </div>
</Base>

    </symbol>
    <symbol id="triangolo" viewBox="0 0 100 100">
      <path d="M50 8 L92 50 L50 92 L8 50 Z" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round" />
      <path d="M8 50 H92 M50 8 L30 50 M50 8 L70 50 M50 92 L36 50 M50 92 L64 50" stroke="currentColor" stroke-width="1.6" opacity=".6" />

    </symbol>
    <symbol id="sismogramma" viewBox="0 0 100 100">
      <path d="M4 50 H28 L34 36 L40 66 L46 18 L52 84 L58 30 L64 60 L70 44 L74 50 H96" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round" />

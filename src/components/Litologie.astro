      <path d="M70 12 L70 28 L54 28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
    <symbol id="ingranaggio" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="14" fill="none" stroke="currentColor" stroke-width="5" />
      <path d="M50 12 V26 M50 74 V88 M12 50 H26 M74 50 H88 M23 23 L33 33 M67 67 L77 77 M23 77 L33 67 M67 33 L77 23" stroke="currentColor" stroke-width="6" stroke-linecap="round" />

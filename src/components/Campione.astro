---
// Un campione di roccia per materia: facce sfaccettate con luce e ombra,
// la litologia della materia in trasparenza, il fossile o il cristallo
// incastonato. Si inclina con il puntatore o il giroscopio (Inclina.astro).
interface Props {
  colore: string;
  materia: string;
  misura?: number;
}
const { colore, materia, misura = 220 } = Astro.props;

const LITOLOGIA: Record<string, string> = {
  "geologia-1": "lit-basalto",
  paleontologia: "lit-calcare",
  "geografia-fisica": "lit-arenaria",
  chimica: "lit-conglomerato",
  matematica: "lit-marna",
};
const INCASTONATO: Record<string, string> = {
  "geologia-1": "fossile-impronta",
  paleontologia: "fossile-ammonite",
  "geografia-fisica": "fossile-conchiglia",
  chimica: "cristallo",
  matematica: "cristallo",
};

// Facce di un sasso irregolare: ogni poligono ha una luminosità diversa.
const FACCE: { punti: string; luce: number }[] = [
  { punti: "30,70 60,22 110,14 150,30 120,66 70,80", luce: 22 },
  { punti: "150,30 190,60 196,110 160,120 120,66", luce: -4 },
  { punti: "30,70 70,80 120,66 160,120 130,170 80,176 44,140", luce: 8 },
  { punti: "30,70 44,140 22,118 14,88", luce: -14 },
  { punti: "44,140 80,176 60,190 36,168", luce: -26 },
  { punti: "80,176 130,170 160,120 196,110 176,160 130,190 92,194 60,190", luce: -18 },
  { punti: "110,14 150,30 120,66 70,80 60,22", luce: 34 },
];
function tono(luce: number) {
  return luce >= 0 ? `color-mix(in srgb, ${colore} ${100 - luce}%, white)` : `color-mix(in srgb, ${colore} ${100 + luce}%, black)`;
}
---

<div class="campione-scena" style={`--materia:${colore};width:${misura}px;height:${misura}px`}>
  <div class="campione relative h-full w-full">
    <svg viewBox="0 0 210 210" class="h-full w-full" style={`color:${colore}`} aria-hidden="true">
      {FACCE.map((f) => <polygon points={f.punti} fill={tono(f.luce)} stroke="rgba(0,0,0,.35)" stroke-width="0.8" stroke-linejoin="round" />)}
      <polygon points="30,70 60,22 110,14 150,30 190,60 196,110 176,160 130,190 92,194 60,190 36,168 22,118 14,88" fill={`url(#${LITOLOGIA[materia] ?? "lit-marna"})`} opacity="0.35" />
      <polygon points="30,70 60,22 110,14 150,30 190,60 196,110 176,160 130,190 92,194 60,190 36,168 22,118 14,88" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1.2" stroke-linejoin="round" />
      <svg x="62" y="62" width="86" height="86" style="color:rgba(255,255,255,.82)">
        <use href={`#${INCASTONATO[materia] ?? "cristallo"}`} />
      </svg>
    </svg>
    <div class="riflesso" />
  </div>
</div>

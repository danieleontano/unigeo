---
// Il menu laterale, come in Minerva: solo i moduli (le sezioni di un modulo
// stanno nelle schede sotto l'intestazione). Fisso a sinistra sul computer,
// riducibile a una colonnina di icone (html[data-menu="rail"], ricordato nel
// browser); a cassetto sul telefono (html[data-menu-aperto]).
import { percorso } from "@/lib/percorsi";
import { IMPOSTAZIONI, MODULI, moduloDi, percorsoPagina } from "@/lib/navigazione";

const attuale = percorsoPagina(Astro.url.pathname, import.meta.env.BASE_URL);
const attivo = moduloDi(attuale).href;
---

<div id="velo-menu" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden" aria-hidden="true"></div>
<aside id="menu" class="menu print:hidden" aria-label="Menu">
  <a href={percorso("/")} class="menu-marchio" title="UniGeo">
    <img src={percorso("/icone/geologia-1.svg")} alt="" width="32" height="32" class="h-8 w-8 shrink-0" />
    <span class="menu-etichetta leading-tight">
      <span class="display block text-[1.25rem] font-semibold" style="color:#f3ecdd">Uni<span style="color:#d98a5c">Geo</span></span>
      <span class="block font-sans text-[0.62rem] tracking-wide text-[#9c8c78]">Scienze Geologiche · 1° anno</span>
    </span>
  </a>

  <nav class="flex-1 overflow-y-auto px-3 py-2 font-sans">
    <ul class="flex flex-col gap-0.5">
      {MODULI.map((m) => (
        <li>
          <a href={percorso(m.href)} class="menu-voce" aria-current={attivo === m.href ? "page" : undefined} title={m.titolo}>
            <svg class="h-[19px] w-[19px] shrink-0" aria-hidden="true"><use href={`#${m.simbolo}`} /></svg>
            <span class="menu-etichetta truncate">{m.titolo}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="border-t border-[#2e251f] px-3 py-3 font-sans">
    <a href={percorso(IMPOSTAZIONI.href)} class="menu-voce" aria-current={attivo === IMPOSTAZIONI.href ? "page" : undefined} title={IMPOSTAZIONI.titolo}>
      <svg class="h-[19px] w-[19px] shrink-0" aria-hidden="true"><use href={`#${IMPOSTAZIONI.simbolo}`} /></svg>
      <span class="menu-etichetta">{IMPOSTAZIONI.titolo}</span>
    </a>
  </div>
</aside>

<script>
  // Il menu ridotto si ricorda nel browser; dopo ogni navigazione Astro
  // rimette gli attributi di <html> della pagina nuova, quindi si riapplica.
  const CHIAVE = "unigeo.menu";
  function applica() {
    let rail = false;
    try {
      rail = localStorage.getItem(CHIAVE) === "rail";
    } catch {}
    if (rail) document.documentElement.setAttribute("data-menu", "rail");
    else document.documentElement.removeAttribute("data-menu");
  }
  function avvia() {
    const html = document.documentElement;
    const chiudi = () => html.removeAttribute("data-menu-aperto");
    document.getElementById("apri-menu")?.addEventListener("click", () => html.setAttribute("data-menu-aperto", ""));
    document.getElementById("riduci-menu")?.addEventListener("click", () => {
      const rail = html.getAttribute("data-menu") !== "rail";
      try {
        localStorage.setItem(CHIAVE, rail ? "rail" : "pieno");
      } catch {}
      applica();
    });
    document.getElementById("velo-menu")?.addEventListener("click", chiudi);
    document.querySelectorAll("#menu a").forEach((a) => a.addEventListener("click", chiudi));
  }
  document.addEventListener("astro:page-load", avvia);
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.removeAttribute("data-menu-aperto");
    applica();
  });
</script>

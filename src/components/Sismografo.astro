---
// Il sismografo della Home con i dati RSNI (UniGe-DISTAV): tracciato su carta
// millimetrata con un picco per evento, in proporzione alla magnitudo, e i
// quattro più recenti. Se il feed non risponde al momento della pubblicazione,
// il riquadro non compare.
import { leggiSismi } from "@/lib/sismi";

const dati = await leggiSismi();
const fmt = (iso: string, opz: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("it-IT", { timeZone: "Europe/Rome", ...opz }).format(new Date(iso));

let picchi: { x: number; a: number; m: number; titolo: string }[] = [];
let punti = "";
const W = 600;
const H = 70;
if (dati) {
  const ev = [...dati.eventi].reverse();
  const t0 = new Date(ev[0].quando).getTime();
  const t1 = new Date(dati.letto).getTime();
  picchi = ev.map((e) => ({
    x: ((new Date(e.quando).getTime() - t0) / Math.max(1, t1 - t0)) * (W - 24) + 12,
    a: Math.max(3, Math.min(H / 2 - 2, (e.magnitudo + 0.5) * 6.5)),
    m: e.magnitudo,
    titolo: `M${e.magnitudo} · ${e.regione}`,
  }));
  const p: string[] = [];
  for (let k = 0; k <= W; k += 6) p.push(`${k},${H / 2 + Math.sin(k * 0.37) * 1.4 + Math.sin(k * 1.13) * 0.9}`);
  punti = p.join(" ");
}
const forte = dati?.eventi.reduce((m, e) => (e.magnitudo > m.magnitudo ? e : m), dati.eventi[0]);
---

{dati && (
  <div class="foglio p-4 pt-6">
    <div class="flex items-baseline justify-between gap-2">
      <p class="etichetta">Sismografo · Italia nord-occidentale</p>
      <a href="https://distav.unige.it/rsni/" target="_blank" rel="noopener noreferrer" class="shrink-0 font-sans text-[0.65rem] text-grafite hover:text-inchiostro">RSNI ↗</a>
    </div>
    <svg viewBox={`0 0 ${W} ${H}`} class="mt-2 h-16 w-full" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <pattern id="carta-sismo" width="20" height="10" patternUnits="userSpaceOnUse">
          <path d="M20 0V10M0 10H20" stroke="#46392f" stroke-width="0.6" />
        </pattern>
      </defs>
      <rect width={W} height={H} fill="url(#carta-sismo)" />
      <polyline points={punti} fill="none" stroke="#8c7e6b" stroke-width="0.8" />
      {picchi.map((p) => (
        <path d={`M${p.x - 4} ${H / 2} L${p.x - 2} ${H / 2 - p.a} L${p.x} ${H / 2 + p.a * 0.8} L${p.x + 2} ${H / 2 - p.a * 0.5} L${p.x + 4} ${H / 2}`} fill="none" stroke={p.m >= 2.5 ? "#e07a4a" : "#efe4d0"} stroke-width="1">
          <title>{p.titolo}</title>
        </path>
      ))}
      <line x1={W - 1} x2={W - 1} y1="0" y2={H} stroke="#c9552a" stroke-width="2" class="pennino" />
    </svg>
    <ol class="mt-2 divide-y divide-filetto font-sans text-xs">
      {dati.eventi.slice(0, 4).map((e) => (
        <li>
          <a href={e.link} target="_blank" rel="noopener noreferrer" class="riga !min-h-0 py-1">
            <span class:list={["display w-9 shrink-0 text-sm font-semibold", e.magnitudo >= 2.5 && "text-lava"]}>{e.magnitudo.toFixed(1)}</span>
            <span class="min-w-0 flex-1 truncate">{e.regione}</span>
            <span class="shrink-0 tabular-nums text-grafite">{fmt(e.quando, { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" })}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="mt-2 font-sans text-[0.65rem] leading-snug text-grafite">
      Ultimi {dati.eventi.length} eventi rivisti dalla Rete Sismica regionale UniGe-DISTAV · il più forte M{forte!.magnitudo.toFixed(1)}, {forte!.regione} · aggiornato alle{" "}
      {fmt(dati.letto, { hour: "2-digit", minute: "2-digit" })} del {fmt(dati.letto, { day: "2-digit", month: "2-digit" })}
    </p>
  </div>
)}

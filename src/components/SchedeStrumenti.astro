---
// Le tessere degli strumenti: in alto l'anteprima viva (AnteprimaStrumento),
// sotto materia, titolo e una riga. Usata in Strumenti e nelle pagine materia.
import AnteprimaStrumento from "@/components/AnteprimaStrumento.astro";
import { percorso } from "@/lib/percorsi";
import { tutteLeMaterie } from "@/lib/contenuti";
import type { Strumento } from "@/lib/strumenti";

interface Props {
  strumenti: Strumento[];
}
const { strumenti } = Astro.props;
const materie = new Map((await tutteLeMaterie()).map((m) => [m.id, m.data]));
---

<ul class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 xl:grid-cols-3">
  {strumenti.map((s, i) => {
    const m = s.materia ? materie.get(s.materia) : undefined;
    return (
      <li class="sale" style={`--i:${i}`}>
        <a href={percorso(s.href)} class="pannello strumento group">
          <div class="strumento-arte"><AnteprimaStrumento href={s.href} /></div>
          <div class="strumento-corpo">
            <span class="materia-etichetta">{m?.nome.replace(" e cartografia", "") ?? "Per tutte"}</span>
            <span class="titolo">{s.titolo}</span>
            <span class="testo">{s.testo}</span>
          </div>
        </a>
      </li>
    );
  })}
</ul>

---
// Le materie come tessere con un oggetto solido in isometrica (OggettoMateria),
// su fondo nel colore della materia: nome, docente e i numeri.
// Su telefono diventano righe strette con l'icona. Usata in Home e in Materie.
import { percorso } from "@/lib/percorsi";
import OggettoMateria from "./OggettoMateria.astro";
import { contaDefinizioni, lezioniDi, quizDisponibili, tutteLeMaterie } from "@/lib/contenuti";

const materie = await tutteLeMaterie();
const lezioni = await lezioniDi();
const quiz = await quizDisponibili();
---

<ul class="grid grid-cols-1 gap-3 sm:grid-cols-3 xl:grid-cols-5">
  {materie.map((m, i) => {
    const mie = lezioni.filter((l) => l.id.startsWith(`${m.id}/`));
    const nQuiz = mie.filter((l) => quiz.has(l.id)).length;
    const nDef = mie.reduce((s, l) => s + contaDefinizioni(l), 0);
    return (
      <li class="sale" style={`--materia:${m.data.colore};--tinta:${m.data.colore};--i:${i + 4}`}>
        <a href={percorso(`/materie/${m.id}`)} class="pannello materia group">
          <div class="materia-foto hidden sm:block">
            <OggettoMateria id={m.id} colore={m.data.colore} />
          </div>
          <span class="shrink-0 sm:hidden"><span class="chip"><img src={percorso(`/icone/${m.data.icona}`)} alt="" width="26" height="26" class="h-[26px] w-[26px]" /></span></span>
          <div class="materia-testo">
            <p class="display text-[1.2rem] leading-tight">{m.data.nome}</p>
            <p class="hidden truncate text-[0.8rem] text-grafite sm:block">{m.data.docenti.length ? m.data.docenti.join(", ") : "Docente da definire"}</p>
          </div>
          <span class="ml-auto shrink-0 font-sans text-xs text-grafite sm:hidden">{mie.length} lez.</span>
          <div class="materia-numeri hidden sm:flex">
            <span><b>{mie.length}</b> lez.</span>
            {nQuiz > 0 && <span><b>{nQuiz}</b> quiz</span>}
            {nDef > 0 && <span><b>{nDef}</b> def.</span>}
          </div>
        </a>
      </li>
    );
  })}
</ul>

---
import "@/styles/globale.css";
import "@/styles/sottosuolo.css";
import { ClientRouter } from "astro:transitions";
import { percorso } from "@/lib/percorsi";
import Litologie from "@/components/Litologie.astro";
import Menu from "@/components/Menu.astro";
import Intestazione from "@/components/Intestazione.astro";
import { IMPRONTE_PREDEFINITE, SOLO_APPUNTI } from "@/lib/accesso";

interface Props {
  titolo: string;
  descrizione?: string;
  /** Colore della materia: tinge titoli e accenti della pagina. */
  colore?: string;
  /** Larghezza del contenuto: «testo» per leggere, «largo» (predefinito) per tutto il resto, «pieno» per gli strumenti grandi. */
  larghezza?: "testo" | "largo" | "pieno";
  /** Compatibilità: largo={true} = larghezza «largo». */
  largo?: boolean;
  /** «carta» per leggere (Libro, lezioni), «sottosuolo» per tutto il resto. */
  tema?: "carta" | "sottosuolo";
  /** Il contenuto si gestisce i margini da sé (home). */
  nudo?: boolean;
}

const { titolo, descrizione, colore, larghezza, largo, tema = "sottosuolo", nudo = false } = Astro.props;
const BASE_SITO = import.meta.env.BASE_URL.replace(/\/$/, "");
const misura = larghezza ?? (largo === false ? "testo" : "largo");
const LARGHEZZE = { testo: "max-w-3xl", largo: "max-w-6xl", pieno: "max-w-[1500px]" };
---

<!doctype html>
<html lang="it" style={colore ? `--materia:${colore}` : undefined} data-tema={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a1411" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={percorso("/favicon.svg")} />
    <link rel="apple-touch-icon" href={percorso("/icone/app-512.png")} />
    <link rel="manifest" href={percorso("/manifest.webmanifest")} />
    <title>{titolo} · UniGeo</title>
    {descrizione && <meta name="description" content={descrizione} />}
    <ClientRouter />
    <script is:inline>
      // Il menu ridotto a icone si applica prima di disegnare, senza scatti.
      try {
        if (localStorage.getItem("unigeo.menu") === "rail") document.documentElement.setAttribute("data-menu", "rail");
      } catch {}
    </script>
    <script is:inline define:vars={{ base: BASE_SITO, impronte: IMPRONTE_PREDEFINITE, soloAppunti: SOLO_APPUNTI }}>
      // La chiave d'accesso (lib/accesso.ts), controllata nel browser prima di
      // disegnare la pagina: senza chiave si va a /accesso; con la chiave degli
      // strumenti niente appunti. Su GitHub Pages è un velo, non una serratura.
      function controllaAccesso() {
        const m = /(?:^|; )unigeo_chiave=([0-9a-f]{64})/.exec(document.cookie);
        const livello = m && m[1] === impronte.appunti ? "appunti" : m && m[1] === impronte.strumenti ? "strumenti" : null;
        const html = document.documentElement;
        if (livello) html.setAttribute("data-livello", livello);
        else html.removeAttribute("data-livello");
        let p = base && location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
        p = p.replace(/\.html$/, "").replace(/\/+$/, "") || "/";
        const da = encodeURIComponent(p + location.search + location.hash);
        if (!livello) return location.replace(`${base}/accesso?da=${da}`);
        if (livello === "strumenti" && p === "/") return location.replace(`${base}/strumenti`);
        if (livello === "strumenti" && soloAppunti.some((x) => p === x || p.startsWith(`${x}/`))) location.replace(`${base}/accesso?serve=appunti&da=${da}`);
      }
      controllaAccesso();
      if (!window.__unigeoAccesso) {
        window.__unigeoAccesso = true;
        document.addEventListener("astro:after-swap", controllaAccesso);
      }
    </script>
  </head>
  <body class="min-h-dvh lg:flex">
    <Litologie />
    <Menu />
    <div class="flex min-h-dvh min-w-0 flex-1 flex-col">
      <Intestazione lettura={tema === "carta"} />
      <main class:list={["mx-auto w-full flex-1", nudo ? "" : `${LARGHEZZE[misura]} px-4 pb-14 pt-6 sm:px-6 lg:px-8 lg:pt-8`]}>
        <slot />
      </main>
    </div>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: percorso("/sw.js"), scope: percorso("/") }}>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register(sw, { scope }).catch(() => {});
      </script>
    )}
  </body>
</html>

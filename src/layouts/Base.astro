---
import "@/styles/globale.css";
import { percorso } from "@/lib/percorsi";

interface Props {
  titolo: string;
  descrizione?: string;
  /** Colore della materia: tinge la riga in alto e i titoli della pagina. */
  colore?: string;
}

const { titolo, descrizione, colore } = Astro.props;
const voci = [
  { href: "/", testo: "Oggi" },
  { href: "/materie", testo: "Materie" },
  { href: "/ripasso", testo: "Ripasso" },
];
const attuale = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
---

<!doctype html>
<html lang="it" style={colore ? `--materia:${colore}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={colore ?? "#3e4a52"} />
    <link rel="icon" type="image/svg+xml" href={percorso("/favicon.svg")} />
    <link rel="apple-touch-icon" href={percorso("/icone/app-512.png")} />
    <link rel="manifest" href={percorso("/manifest.webmanifest")} />
    <title>{titolo} · UniGeo</title>
    {descrizione && <meta name="description" content={descrizione} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-10 border-b border-line bg-white/95 backdrop-blur print:hidden">
      <div class="mx-auto flex h-11 max-w-3xl items-center justify-between px-4">
        <a href={percorso("/")} class="font-sans text-sm font-semibold tracking-tight text-materia">
          UniGeo
        </a>
        <nav class="flex gap-1 font-sans text-sm">
          {voci.map((v) => (
            <a
              href={percorso(v.href)}
              class:list={[
                "rounded px-2.5 py-1",
                attuale === v.href || (v.href !== "/" && attuale.startsWith(v.href))
                  ? "bg-sand font-medium text-slate"
                  : "text-muted hover:text-slate",
              ]}
            >
              {v.testo}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 pb-10 pt-5">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-3xl px-4 pb-6 font-sans text-xs text-muted print:hidden">
      <a href={percorso("/impostazioni")} class="hover:text-slate">Impostazioni</a>
    </footer>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: percorso("/sw.js"), scope: percorso("/") }}>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register(sw, { scope }).catch(() => {});
      </script>
    )}
  </body>
</html>

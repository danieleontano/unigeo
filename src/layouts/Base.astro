---
import "@/styles/globale.css";
import { percorso } from "@/lib/percorsi";
import Strati from "@/components/Strati.astro";

interface Props {
  titolo: string;
  descrizione?: string;
  /** Colore della materia: tinge titoli e accenti della pagina. */
  colore?: string;
  /** Il Libro gestisce da sé larghezza e sfondo. */
  largo?: boolean;
}

const { titolo, descrizione, colore, largo = false } = Astro.props;
const voci = [
  { href: "/", testo: "Taccuino" },
  { href: "/materie", testo: "Materie" },
  { href: "/da-fare", testo: "Da fare" },
  { href: "/ripasso", testo: "Ripasso" },
];
const attuale = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
---

<!doctype html>
<html lang="it" style={colore ? `--materia:${colore}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" type="image/svg+xml" href={percorso("/favicon.svg")} />
    <link rel="apple-touch-icon" href={percorso("/icone/app-512.png")} />
    <link rel="manifest" href={percorso("/manifest.webmanifest")} />
    <title>{titolo} · UniGeo</title>
    {descrizione && <meta name="description" content={descrizione} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-20 bg-carta/92 backdrop-blur print:hidden">
      <div class="mx-auto flex h-12 max-w-5xl items-center justify-between px-4">
        <a href={percorso("/")} class="display text-[1.35rem] font-semibold tracking-tight text-inchiostro">
          Uni<span class="text-lava">Geo</span>
        </a>
        <nav class="flex gap-0.5 whitespace-nowrap font-sans text-[0.78rem] sm:text-[0.85rem]">
          {voci.map((v) => (
            <a
              href={percorso(v.href)}
              class:list={[
                "rounded-md px-1.5 py-1 transition sm:px-2.5",
                attuale === v.href || (v.href !== "/" && attuale.startsWith(v.href))
                  ? "bg-sabbia font-medium text-inchiostro"
                  : "text-grafite hover:text-inchiostro",
              ]}
            >
              {v.testo}
            </a>
          ))}
        </nav>
      </div>
      <Strati />
    </header>
    <main class:list={["mx-auto w-full flex-1 px-4 pb-12 pt-6", largo ? "max-w-5xl" : "max-w-3xl"]}>
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-3xl px-4 pb-6 font-sans text-xs text-grafite print:hidden">
      <a href={percorso("/impostazioni")} class="hover:text-inchiostro">Impostazioni</a>
    </footer>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: percorso("/sw.js"), scope: percorso("/") }}>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register(sw, { scope }).catch(() => {});
      </script>
    )}
  </body>
</html>

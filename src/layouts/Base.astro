---
import "@/styles/globale.css";
import "@/styles/sottosuolo.css";
import { ClientRouter } from "astro:transitions";
import { percorso } from "@/lib/percorsi";
import Strati from "@/components/Strati.astro";
import Litologie from "@/components/Litologie.astro";

interface Props {
  titolo: string;
  descrizione?: string;
  /** Colore della materia: tinge titoli e accenti della pagina. */
  colore?: string;
  /** Colonna larga (home, materie, Libro). */
  largo?: boolean;
  /** «carta» per leggere (Libro, lezioni), «sottosuolo» per scoprire (home, materie, quiz…). */
  tema?: "carta" | "sottosuolo";
  /** Senza riga in alto né piede: la pagina fa da sé (home). */
  nudo?: boolean;
}

const { titolo, descrizione, colore, largo = false, tema = "carta", nudo = false } = Astro.props;
const voci = [
  { href: "/", testo: "Taccuino" },
  { href: "/materie", testo: "Materie" },
  { href: "/da-fare", testo: "Da fare" },
  { href: "/ripasso", testo: "Ripasso" },
];
const attuale = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
---

<!doctype html>
<html lang="it" style={colore ? `--materia:${colore}` : undefined} data-tema={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={tema === "sottosuolo" ? "#111417" : "#f6f1e7"} />
    <link rel="icon" type="image/svg+xml" href={percorso("/favicon.svg")} />
    <link rel="apple-touch-icon" href={percorso("/icone/app-512.png")} />
    <link rel="manifest" href={percorso("/manifest.webmanifest")} />
    <title>{titolo} · UniGeo</title>
    {descrizione && <meta name="description" content={descrizione} />}
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Litologie />
    <header class="sticky top-0 z-20 backdrop-blur print:hidden" style="background: color-mix(in srgb, var(--carta) 90%, transparent)" transition:name="barra" transition:persist>
      <div class:list={["mx-auto flex h-12 items-center justify-between px-4", largo ? "max-w-5xl" : "max-w-3xl"]}>
        <a href={percorso("/")} class="display text-[1.35rem] font-semibold tracking-tight text-inchiostro">
          Uni<span class="text-lava">Geo</span>
        </a>
        <nav class="flex gap-0.5 whitespace-nowrap font-sans text-[0.78rem] sm:text-[0.85rem]">
          {voci.map((v) => (
            <a
              href={percorso(v.href)}
              class:list={[
                "rounded-md px-1.5 py-1 transition sm:px-2.5",
                attuale === v.href || (v.href !== "/" && attuale.startsWith(v.href))
                  ? "bg-sabbia font-medium text-inchiostro"
                  : "text-grafite hover:text-inchiostro",
              ]}
            >
              {v.testo}
            </a>
          ))}
        </nav>
      </div>
      <Strati />
    </header>
    <main class:list={["mx-auto w-full flex-1", nudo ? "max-w-none" : largo ? "max-w-5xl px-4 pb-12 pt-6" : "max-w-3xl px-4 pb-12 pt-6"]}>
      <slot />
    </main>
    <footer class:list={["mx-auto w-full px-4 pb-6 font-sans text-xs text-grafite print:hidden", largo ? "max-w-5xl" : "max-w-3xl"]}>
      <a href={percorso("/impostazioni")} class="hover:text-inchiostro">Impostazioni</a>
    </footer>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: percorso("/sw.js"), scope: percorso("/") }}>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register(sw, { scope }).catch(() => {});
      </script>
    )}
  </body>
</html>
